;; Test-owned host lifecycle proof, not an SDK conformance fixture.
;; Exclusive Store: one live HTTP context. Every callback checks its context.
;; The 36-byte shared record is bytes(u64), chunks, headers, trailers, eos,
;; done, request-body completion and delete (seven little-endian u32 values).
(module
  (import "env" "proxy_get_header_map_value" (func $get_header (param i32 i32 i32 i32 i32) (result i32)))
  (import "env" "proxy_replace_header_map_value" (func $set_header (param i32 i32 i32 i32 i32) (result i32)))
  (import "env" "proxy_get_buffer_bytes" (func $get_buffer (param i32 i32 i32 i32 i32) (result i32)))
  (import "env" "proxy_set_shared_data" (func $set_shared (param i32 i32 i32 i32 i32) (result i32)))
  (import "env" "proxy_get_shared_data" (func $get_shared (param i32 i32 i32 i32 i32) (result i32)))
  (memory (export "memory") 2 2)
  (global $heap (mut i32) (i32.const 4096))
  (global $context (mut i32) (i32.const 0))
  (global $marker_len (mut i32) (i32.const 0))
  (global $probe_len (mut i32) (i32.const 0))
  (data (i32.const 100) "x-lifecycle-id")
  (data (i32.const 130) "x-context-request")
  (data (i32.const 160) "x-context-response")
  (data (i32.const 190) "x-lifecycle-trailer")
  (data (i32.const 220) "x-probe-target")
  (data (i32.const 250) "x-proof")
  (data (i32.const 280) "0123456789abcdef")
  (func (export "proxy_abi_version_0_2_1"))
  (func $assert (param $ok i32) (if (i32.eqz (local.get $ok)) (then unreachable)))
  (func $context_check (param $ctx i32)
    (call $assert (i32.eq (local.get $ctx) (global.get $context)))
    (global.set $heap (i32.const 4096)))
  (func $equal (param $a i32) (param $b i32) (param $n i32) (result i32)
    (local $i i32)
    (block $end
      (loop $next
        (br_if $end (i32.ge_u (local.get $i) (local.get $n)))
        (if (i32.ne (i32.load8_u (i32.add (local.get $a) (local.get $i)))
                    (i32.load8_u (i32.add (local.get $b) (local.get $i))))
          (then (return (i32.const 0))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $next)))
    (i32.const 1))
  (func $publish
    (if (i32.eqz (global.get $probe_len))
      (then (call $assert (i32.eqz (call $set_shared (i32.const 512) (global.get $marker_len)
        (i32.const 2048) (i32.const 36) (i32.const 0)))))))
  (func (export "proxy_on_memory_allocate") (param $n i32) (result i32)
    (local $old i32)
    (local.set $old (global.get $heap))
    (global.set $heap (i32.add (global.get $heap) (local.get $n)))
    (call $assert (i32.lt_u (global.get $heap) (i32.const 131072)))
    (local.get $old))
  (func (export "proxy_on_context_create") (param $ctx i32) (param $parent i32)
    (if (local.get $parent) (then
      (global.set $context (local.get $ctx))
      (global.set $probe_len (i32.const 0))
      (memory.fill (i32.const 2048) (i32.const 0) (i32.const 36)))))
  (func (export "proxy_on_vm_start") (param i32 i32) (result i32) (i32.const 1))
  (func (export "proxy_on_configure") (param i32 i32) (result i32) (i32.const 1))
  (func (export "proxy_on_request_headers") (param $ctx i32) (param i32) (param $eos i32) (result i32)
    (call $context_check (local.get $ctx))
    (call $assert (i32.eqz (local.get $eos)))
    (call $assert (i32.eqz (call $get_header (i32.const 0) (i32.const 100) (i32.const 14) (i32.const 0) (i32.const 4))))
    (global.set $marker_len (i32.load (i32.const 4)))
    (call $assert (i32.le_u (global.get $marker_len) (i32.const 128)))
    (memory.copy (i32.const 512) (i32.load (i32.const 0)) (global.get $marker_len))
    (if (i32.eqz (call $get_header (i32.const 0) (i32.const 220) (i32.const 14) (i32.const 0) (i32.const 4)))
      (then
        (global.set $probe_len (i32.load (i32.const 4)))
        (call $assert (i32.le_u (global.get $probe_len) (i32.const 128)))
        (memory.copy (i32.const 768) (i32.load (i32.const 0)) (global.get $probe_len))))
    (i32.const 0))
  (func (export "proxy_on_request_body") (param $ctx i32) (param $size i32) (param $eos i32) (result i32)
    (call $context_check (local.get $ctx))
    (call $assert (local.get $eos))
    (call $assert (i32.eqz (i32.load (i32.const 2076))))
    (call $assert (i32.eq (local.get $size) (global.get $marker_len)))
    (call $assert (i32.eqz (call $get_buffer (i32.const 0) (i32.const 0) (local.get $size) (i32.const 0) (i32.const 4))))
    (call $assert (i32.eq (i32.load (i32.const 4)) (global.get $marker_len)))
    (call $assert (call $equal (i32.load (i32.const 0)) (i32.const 512) (global.get $marker_len)))
    (i32.store (i32.const 2076) (i32.const 1))
    (call $assert (i32.eqz (call $set_header (i32.const 0) (i32.const 130) (i32.const 17) (i32.const 512) (global.get $marker_len))))
    (call $publish)
    (i32.const 0))
  (func (export "proxy_on_response_headers") (param $ctx i32) (param i32) (param $eos i32) (result i32)
    (local $i i32) (local $byte i32) (local $p i32)
    (call $context_check (local.get $ctx))
    (call $assert (i32.eq (i32.load (i32.const 2076)) (i32.const 1)))
    (call $assert (i32.eqz (call $set_header (i32.const 2) (i32.const 160) (i32.const 18) (i32.const 512) (global.get $marker_len))))
    (i32.store (i32.const 2060) (i32.add (i32.load (i32.const 2060)) (i32.const 1)))
    (i32.store (i32.const 2068) (local.get $eos))
    (if (global.get $probe_len) (then
      (call $assert (i32.eqz (call $get_shared (i32.const 768) (global.get $probe_len) (i32.const 0) (i32.const 4) (i32.const 8))))
      (call $assert (i32.eq (i32.load (i32.const 4)) (i32.const 36)))
      (local.set $p (i32.load (i32.const 0)))
      (loop $encode
        (local.set $byte (i32.load8_u (i32.add (local.get $p) (local.get $i))))
        (i32.store8 (i32.add (i32.const 3072) (i32.mul (local.get $i) (i32.const 2)))
          (i32.load8_u (i32.add (i32.const 280) (i32.shr_u (local.get $byte) (i32.const 4)))))
        (i32.store8 (i32.add (i32.const 3073) (i32.mul (local.get $i) (i32.const 2)))
          (i32.load8_u (i32.add (i32.const 280) (i32.and (local.get $byte) (i32.const 15)))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br_if $encode (i32.lt_u (local.get $i) (i32.const 36))))
      (call $assert (i32.eqz (call $set_header (i32.const 2) (i32.const 250) (i32.const 7) (i32.const 3072) (i32.const 72))))))
    (call $publish)
    (i32.const 0))
  (func (export "proxy_on_response_body") (param $ctx i32) (param $size i32) (param $eos i32) (result i32)
    (call $context_check (local.get $ctx))
    (call $assert (i32.eq (i32.load (i32.const 2076)) (i32.const 1)))
    (call $assert (i32.eqz (i32.load (i32.const 2068))))
    (i64.store (i32.const 2048) (i64.add (i64.load (i32.const 2048)) (i64.extend_i32_u (local.get $size))))
    (i32.store (i32.const 2056) (i32.add (i32.load (i32.const 2056)) (i32.const 1)))
    (i32.store (i32.const 2068) (local.get $eos))
    (call $publish)
    (i32.const 0))
  (func (export "proxy_on_response_trailers") (param $ctx i32) (param i32) (result i32)
    (call $context_check (local.get $ctx))
    (call $assert (i32.eqz (i32.load (i32.const 2068))))
    (call $assert (i32.eqz (call $get_header (i32.const 3) (i32.const 190) (i32.const 19) (i32.const 0) (i32.const 4))))
    (call $assert (i32.eq (i32.load (i32.const 4)) (global.get $marker_len)))
    (call $assert (call $equal (i32.load (i32.const 0)) (i32.const 512) (global.get $marker_len)))
    (i32.store (i32.const 2064) (i32.add (i32.load (i32.const 2064)) (i32.const 1)))
    (i32.store (i32.const 2068) (i32.const 1))
    (call $publish)
    (i32.const 0))
  (func (export "proxy_on_done") (param $ctx i32) (result i32)
    (call $context_check (local.get $ctx))
    (i32.store (i32.const 2072) (i32.add (i32.load (i32.const 2072)) (i32.const 1)))
    (call $publish)
    (i32.const 1))
  (func (export "proxy_on_delete") (param $ctx i32)
    (call $context_check (local.get $ctx))
    (i32.store (i32.const 2080) (i32.add (i32.load (i32.const 2080)) (i32.const 1)))
    (call $publish))
)
