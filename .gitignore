.idea/
.gemini/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Build artifacts
*.o
*.so
*.dylib
*.dll
*.a
*.lib

# Integration test workspace (generated at runtime, do not commit)
integration_testing/

# Temporary conformance test files (copied from upstream, not tracked)
.tmp-conformance-tests/

# Generated conf_sync mTLS certificates (never commit private keys)
examples/test/certs/conf-sync-grpc/

# Cross-compilation config (personal dev workflow)
Cross.toml
Dockerfile.cross
Dockerfile.cross.musl

# K8s test configuration (generated at runtime)
examples/test/k8s-conf/

# K8s integration test image config (generated by fast_build.sh, personal dev config)
examples/k8stest/scripts/config/images.env

.understand-anything/

# All-in-one build artifacts (generated by build-image.sh --all-in-one-*)
docker/.all-in-one-dist/
docker/.all-in-one-dashboard/

# Embedded dashboard: NOT vendored. The edgion-dashboard build output is staged
# here at image-build time and a build.rs placeholder is generated for local
# `--features embed-dashboard` compiles. Never commit it.
/web/

docs/superpowers/
.worktrees/

# VitePress
node_modules/
docs/.vitepress/dist/
docs/.vitepress/cache/
