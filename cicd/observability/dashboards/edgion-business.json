{
  "title": "Edgion — Business",
  "uid": "edgion-business",
  "schemaVersion": 38,
  "version": 1,
  "editable": true,
  "tags": ["edgion"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "label": "Datasource"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(edgion_backend_requests_total[5m]))" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error rate",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(edgion_backend_requests_total{status=~\"5xx|failed\"}[5m])) / sum(rate(edgion_backend_requests_total[5m]))" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "p99 latency (histogram; enable request_duration)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.99, sum(rate(edgion_gateway_request_duration_ms_bucket[5m])) by (le))" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "LB panic mode",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "edgion_lb_panic_mode" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Circuit-breaker rejections",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "rate(edgion_circuit_breaker_rejections_total[5m])" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Circuit-breaker ejections",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "rate(edgion_circuit_breaker_ejections_total[5m])" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Connection rate-limit rejections",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "rate(edgion_connection_rate_limit_rejected_total[5m])" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Mirror outcomes",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (status) (rate(edgion_mirror_requests_total[5m]))" }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Request/response bytes",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(edgion_gateway_request_bytes_total[5m]))" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(edgion_gateway_response_bytes_total[5m]))" }
      ]
    }
  ]
}
