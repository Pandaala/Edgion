{
  "title": "Edgion — Federation",
  "uid": "edgion-federation",
  "schemaVersion": 38,
  "version": 1,
  "editable": true,
  "tags": ["edgion"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "label": "Datasource"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "Aggregator/watch-error panels require EdgionCenter (separate repo); on a Controller-only deployment those series are absent."
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Active fed connections",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "edgion_fed_connections_active" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Connection events",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (event) (rate(edgion_fed_connection_events_total[5m]))" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Watch events",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (kind,direction) (rate(edgion_fed_watch_events_total[5m]))" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "RBAC denied",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "rate(edgion_fed_rbac_denied_total[5m])" }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Kill-switch state",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "edgion_fed_kill_switch_state" }
      ]
    }
  ]
}
