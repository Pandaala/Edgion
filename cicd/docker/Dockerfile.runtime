# Edgion CI Dockerfile - For prebuilt binaries
# Used by GitHub Actions for multi-arch builds with cross-compiled binaries
# Also used for local fast builds (--local-build option)
#
# Build arguments:
#   RUNTIME_BASE: Runtime base image (default: debian:bookworm-slim)
#   BINARY: Target binary name (e.g., gateway, gateway-stock, controller, test_server)
#   BUILD_TYPE: Build type - bin or example (default: bin)
#   BINARY_PATH: Path to prebuilt binaries directory
#   EXTRA_PACKAGES: Optional extra apt packages for runtime image
#
# Usage:
#   # For bin type
#   docker build -f docker/Dockerfile.runtime --build-arg BINARY=gateway --build-arg BUILD_TYPE=bin --build-arg BINARY_PATH=target/release -t edgion/edgion-gateway:0.1.0 .
#   # For example type
#   docker build -f docker/Dockerfile.runtime --build-arg BINARY=test_server --build-arg BUILD_TYPE=example --build-arg BINARY_PATH=target/release -t edgion/edgion-test-server:0.1.0 .

ARG RUNTIME_BASE=debian:bookworm-slim
FROM ${RUNTIME_BASE}

# Build arguments
ARG BINARY=gateway
ARG BUILD_TYPE=bin
ARG BINARY_PATH
ARG EXTRA_PACKAGES=""

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    procps \
    && if [ -n "${EXTRA_PACKAGES}" ]; then apt-get install -y --no-install-recommends ${EXTRA_PACKAGES}; fi \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -g 1000 edgion 2>/dev/null || groupadd edgion && \
    useradd -r -u 1000 -g edgion edgion 2>/dev/null || useradd -r -g edgion edgion

WORKDIR /usr/local/edgion
RUN chown -R edgion:edgion /usr/local/edgion

# Copy prebuilt binaries based on BUILD_TYPE
# For bin: product binaries are prefixed `edgion-<name>`; for example: the
# edgion-tests harness binaries (test_server/test_client) are plain `[[bin]]`
# targets, so they land directly in the binary dir with no prefix and no
# `examples/` subdir.
RUN --mount=type=bind,source=${BINARY_PATH},target=/tmp/binaries \
    if [ "$BUILD_TYPE" = "example" ]; then \
      cp /tmp/binaries/${BINARY} /usr/local/bin/${BINARY} && \
      chmod +x /usr/local/bin/${BINARY}; \
    else \
      cp /tmp/binaries/edgion-${BINARY} /usr/local/bin/edgion-${BINARY} && \
      cp /tmp/binaries/edgion-cli /usr/local/bin/edgion-cli && \
      chmod +x /usr/local/bin/edgion-${BINARY} /usr/local/bin/edgion-cli; \
    fi

# Ensure the config directory exists as the mount point. Config is always provided at
# runtime via a mount -- a Kubernetes ConfigMap at /usr/local/edgion/config (see
# cicd/deploy/kubernetes/), or a user bind-mount for non-Kubernetes modes. The image
# deliberately bakes in NO default config: the repo's config/*.yaml are development
# configs (file_system mode, debug enabled, test conf_dir) and would be misleading in a
# production image. (This replaces a long-dead `cp config/*.toml` -- the configs are YAML,
# so that copy always matched nothing.)
RUN mkdir -p ./config && chown -R edgion:edgion ./config

# Switch to non-root user
USER edgion

# Environment variables
ENV RUST_LOG=info
ENV RUST_BACKTRACE=full

# Expose ports
EXPOSE 80 443 10080 10443 18443 19000 19002 19010 12151 12101

# Set entrypoint
ENTRYPOINT ["/bin/sh", "-c"]
CMD ["exec /usr/local/bin/edgion-${BINARY}"]

# Labels
LABEL maintainer="Edgion Team"
LABEL org.opencontainers.image.source="https://github.com/Pandaala/Edgion"
LABEL org.opencontainers.image.description="Edgion - Kubernetes Gateway API Implementation"
LABEL org.opencontainers.image.licenses="Apache-2.0"
