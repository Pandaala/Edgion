# Edgion All-in-One Dockerfile
# Packages pre-built backend binaries + pre-built frontend (dist) + nginx
#
# Mode:
#   controller-gateway: edgion-controller + edgion-gateway + frontend dashboard
#
# Note: the `center` all-in-one mode has been retired. edgion-center now embeds
# the dashboard directly into the binary (the `embed-dashboard` Cargo feature)
# and serves it same-origin — build the standard center image instead.
#
# Build arguments:
#   ALL_IN_ONE_MODE:     "controller-gateway"
#   BINARY_PATH:         Path to pre-built backend binaries (e.g. target/aarch64-unknown-linux-gnu/release)
#   DASHBOARD_DIST_PATH: Path to pre-built frontend dist directory
#   RUNTIME_BASE:        Runtime base image (default: ubuntu:24.04)
#
# Usage (called by build-image.sh --all-in-one-controller-gateway):
#   docker buildx build -f docker/Dockerfile.all-in-one \
#     --build-arg ALL_IN_ONE_MODE=controller-gateway \
#     --build-arg BINARY_PATH=target/aarch64-unknown-linux-gnu/release \
#     --build-arg DASHBOARD_DIST_PATH=docker/.all-in-one-dist \
#     -t edgion-all-in-one:latest .

ARG RUNTIME_BASE=debian:bookworm-slim
FROM ${RUNTIME_BASE}

ARG ALL_IN_ONE_MODE=controller-gateway
ARG BINARY_PATH
ARG DASHBOARD_DIST_PATH

# Install runtime dependencies + nginx
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    nginx \
    procps \
    && rm -rf /var/lib/apt/lists/*

# Copy pre-built backend binaries (controller-gateway mode)
RUN --mount=type=bind,source=${BINARY_PATH},target=/tmp/binaries \
    if [ "$ALL_IN_ONE_MODE" = "controller-gateway" ]; then \
      cp /tmp/binaries/edgion-controller /usr/local/bin/edgion-controller && \
      cp /tmp/binaries/edgion-gateway /usr/local/bin/edgion-gateway && \
      cp /tmp/binaries/edgion-cli /usr/local/bin/edgion-cli && \
      chmod +x /usr/local/bin/edgion-controller /usr/local/bin/edgion-gateway /usr/local/bin/edgion-cli; \
    fi

# Copy frontend dist
RUN --mount=type=bind,source=${DASHBOARD_DIST_PATH},target=/tmp/dist \
    rm -rf /usr/share/nginx/html/* && \
    cp -r /tmp/dist/* /usr/share/nginx/html/

# Copy nginx config and remove defaults that may conflict
COPY docker/nginx/all-in-one-${ALL_IN_ONE_MODE}.conf /etc/nginx/sites-enabled/default
RUN rm -f /etc/nginx/conf.d/default.conf

# Copy config files
RUN --mount=type=bind,source=config,target=/tmp/config \
    mkdir -p /etc/edgion && \
    cp -r /tmp/config/*.toml /etc/edgion/ 2>/dev/null; true

COPY --chmod=755 docker/all-in-one-entrypoint.sh /usr/local/bin/all-in-one-entrypoint.sh

ENV ALL_IN_ONE_MODE=${ALL_IN_ONE_MODE}
ENV RUST_LOG=info
ENV RUST_BACKTRACE=0

# Expose ports:
#   5800 — dashboard + controller API (nginx external listen)
#   80, 443 — gateway data plane
#   12151 — controller gRPC
EXPOSE 80 443 5800 12151

ENTRYPOINT ["/usr/local/bin/all-in-one-entrypoint.sh"]

# Labels
LABEL maintainer="Edgion Team"
LABEL org.opencontainers.image.source="https://github.com/Pandaala/Edgion"
LABEL org.opencontainers.image.description="Edgion All-in-One - Frontend Dashboard + Backend"
LABEL org.opencontainers.image.licenses="Apache-2.0"
