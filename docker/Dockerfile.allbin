# Build all edgion binaries in one pass: controller, cli
# Uses BuildKit cache mounts for fast incremental builds.
#
# First build:  ~5-8 min (full compile)
# Incremental:  ~10-30s (only changed crates recompile)
#
# Usage:
#   docker buildx build --load -t edgion-all:local -f docker/Dockerfile.allbin .

ARG RUST_VERSION=1.92

FROM rust:${RUST_VERSION}-slim AS builder
RUN apt-get update && apt-get install -y \
    g++ cmake git libclang-dev lld perl pkg-config protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*
ENV RUSTFLAGS="-C link-arg=-fuse-ld=lld"
WORKDIR /app

# Copy manifests first (rarely change → cached layer)
COPY Cargo.toml Cargo.lock build.rs ./

# Copy source
COPY src src
COPY config config
COPY examples/test/conf examples/test/conf

# Build with persistent cargo/target cache mounts
# - /usr/local/cargo/registry: downloaded crate sources (shared across builds)
# - /app/target: compilation artifacts (incremental build cache)
# After build, copy binaries out of the cache mount to a regular layer
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/app/target \
    cargo build --release -p edgion-controller --features default --bin edgion-controller \
    && cargo build --release -p edgion-cli --bin edgion-cli \
    && cp target/release/edgion-controller target/release/edgion-cli /usr/local/bin/

# Runtime
FROM ubuntu:24.04
RUN apt-get update && apt-get install -y ca-certificates curl iproute2 net-tools procps vim \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /usr/local/bin/edgion-controller /usr/local/bin/
COPY --from=builder /usr/local/bin/edgion-cli /usr/local/bin/
COPY --from=builder /app/config /edgion/config
COPY --from=builder /app/examples/test/conf /edgion/test-conf
WORKDIR /edgion
CMD ["sleep", "infinity"]
