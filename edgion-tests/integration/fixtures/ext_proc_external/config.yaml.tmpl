# Full-test-only resources for the independently generated Go ExtProc fixture.
# The integration startup script renders the loopback target token before load.
apiVersion: edgion.io/v1
kind: EdgionPlugins
metadata:
  name: ext-proc-external
  namespace: edgion-default
spec:
  requestPlugins:
    - enable: true
      type: ExtProc
      config:
        grpcService:
          target: "__EXTERNAL_EXT_PROC_TARGET__"
          timeoutMs: 5000
        processingMode:
          requestHeaderMode: SEND
          responseHeaderMode: SEND
        failureModeAllow: false
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: ext-proc-external-route
  namespace: edgion-default
spec:
  parentRefs:
    - name: edgion-plugins-gateway
      namespace: edgion-test
  hostnames:
    - "ext-proc-external.example.com"
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /
      filters:
        - type: ExtensionRef
          extensionRef:
            group: edgion.io
            kind: EdgionPlugins
            name: ext-proc-external
      backendRefs:
        - name: test-http
          namespace: edgion-test
          port: 30001
---
