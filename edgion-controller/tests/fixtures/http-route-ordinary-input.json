{
  "apiVersion": "gateway.networking.k8s.io/v1",
  "kind": "HTTPRoute",
  "metadata": {"namespace": "apps", "name": "ordinary", "uid": "ordinary-uid", "generation": 3},
  "spec": {
    "parentRefs": [{"name": "gw", "sectionName": "http"}],
    "hostnames": ["app.example.com"],
    "resolvedDelegationKeys": [{"kind": "HTTPRoute", "parent_ns": "x", "parent_name": "y", "target_ns": "apps", "target_name": "*"}],
    "rules": [
      {
        "name": "primary",
        "matches": [{"path": {"type": "PathPrefix", "value": "/api"}, "method": "GET"}],
        "filters": [
          {"type": "RequestHeaderModifier", "requestHeaderModifier": {"set": [{"name": "x-a", "value": "1"}]}},
          {"type": "ExtensionRef", "extensionRef": {
            "group": "edgion.io", "kind": "EdgionPlugins", "name": "plug", "resolvedNamespace": "injected"
          }}
        ],
        "backendRefs": [
          {"name": "svc", "port": 80, "weight": 3},
          {"name": "other", "namespace": "secret-ns", "port": 81}
        ],
        "timeouts": {"request": "5s"}
      },
      {
        "matches": [{"path": {"type": "Exact", "value": "/auth"}}],
        "filters": [{"type": "ExternalAuth", "resolvedExternalAuth": {"namespace": "forged"}, "externalAuth": {
          "target": {"name": "auth", "port": 8080}, "decision": {},
          "request": {"path": {"template": "/check/${secretRef:material/token:key}"}},
          "resolvedSecrets": {"material/token:key": "forged-value"}
        }}],
        "backendRefs": [{"name": "svc", "port": 80}]
      },
      {"backendRefs": [{"name": "fallback", "port": 8080}], "resolvedTerminalRouteUid": "forged"}
    ]
  }
}
